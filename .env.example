# Copier ce fichier en .env.local et renseigner les valeurs.

# URL publique du site (liens partagés, métadonnées).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données PostgreSQL de production (Supabase, Neon…).
# Vide : base intégrée PGlite stockée dans .data/pglite (démonstration locale).
DATABASE_URL=

# Mode démonstration : catalogue d'exemple et comptes de démonstration.
# Par défaut : activé sans DATABASE_URL, désactivé avec.
DEMO_MODE=

# Autorise l'indexation par les moteurs de recherche (uniquement sans données d'exemple).
SITE_INDEXABLE=false
